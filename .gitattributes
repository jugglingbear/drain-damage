# Keep source and metadata diffable; store retained binary media with Git LFS.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
# Future explicitly requested release packages (no release binaries added automatically).
dist/**/*.dmg filter=lfs diff=lfs merge=lfs -text
dist/**/*.apk filter=lfs diff=lfs merge=lfs -text
dist/**/*.aab filter=lfs diff=lfs merge=lfs -text
dist/**/*.ipa filter=lfs diff=lfs merge=lfs -text
dist/**/*.exe filter=lfs diff=lfs merge=lfs -text
dist/**/*.pck filter=lfs diff=lfs merge=lfs -text
dist/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
dist/**/*.tar.xz filter=lfs diff=lfs merge=lfs -text
*.icns filter=lfs diff=lfs merge=lfs -text
