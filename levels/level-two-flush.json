  "hazard_rules": {
    "positions": "angle/radius_fraction define fixed unprojected center atR360; project y by140/360. No retargeting after warning.",
    "collision": "World-plane hero14+hazard22 gives36 combined footprint. Use projected elliptical warning of36worldradius. Jump clearance via Mechanics projected-height contract. One damage and shared invulnerability.",
    "soft_paper": "24HP, both starter weapons can break; shooting is optional.",
    "hard_porcelain": "Distinct intact hard material; dodge/jump, not required shooting",
    "safety": "Before warning commits verify a reachable safe disk radius48world within annulus, clear of combined36world impact footprints, using min235-currentcap (Hard155), reactionbuffer0.15s and actual planned current. Test full path rather than straight endpoint through inner forbidden disk. Skip unsafe event without backlog; never move an already warned footprint.",
    "minimum_net_steering_speed_reference": 155,
    "overlap": "Do not overlap same-position warnings/impacts. Spawn caps count live damaging objects; pending warnings must also pass combined future-impact safety.",
    "deadline": "No hazard may remain damaging at35s. Clear all pending warnings, projectiles and contacts before automatic drain.",
    "visual_layers": "Warnings/shadows projected onto water; billboard hero height46 and projected jumpmax33.64 leave top>=97.16, belowHUD64. Art rim must not obscure playable edge.",
    "completion": "At45s emit log_landed exactly once if alive; no kill quota. Dead/game-over cannot complete.",
    "retry": "Full attempt restart under Mechanics life/health rules; no mid-bowl checkpoint. Log landing is next-stage boundary, not an implemented ride.",
    "jump_clearance": "Mechanics owns airborne threshold; all debris is low and jumpable. Do not use raw screen distance for world collision."
  },
  "art_contract": "Separate bowl, drain/current layers, hard porcelain, soft paper, warning/impact effects and landing log. Art owns all authored images; no generated substitute by Engineering.",
  "validation_required": [
    "Both heroes/all difficulties can steer every direction at inner/outer ellipse limits",
    "Actual slowed movement/current preserves at least one reachable safe pocket for each emitted warning",
    "Pause never consumes warning time; unfinished blocking intro holds at8s before hazards; retry retains calm phase",
    "Hard and soft silhouettes and warnings readable at960x540",
    "Jump and shot collision follow visible impact footprints",
    "At35s no pending or active damage, automatic drain cannot hurt hero",
    "Retry clears all events and45s completion emits once; no game-over completion",
    "No full ride or invented enemies/story outcome beyond landing"
  ],
