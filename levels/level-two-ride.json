  "warning_contract": {
    "offscreen_cues": "Right-edge authored kind/bank cue begins at warning_at, even before obstacle art enters view. Minimum lead uses earliest contact at x650, not reference crossing.",
    "jump_ready": "Current-anchor-relative leading edge and landing shadow, not a fixed countdown to reference_x. Hold neutral or right during a gap jump; left can deliberately stall forward clearance.",
    "readability": "Art must distinguish tall unjumpable supports, low jumpable bars, and a missing-water gap. Keep critical cues inside water region and outside radio/HUD.",
    "no_surprise": "Do not spawn, retarget, accelerate or change bank after warning. All listed events are fixed before ride begins."
  },
  "checkpoint": {
    "entry": "Existing safe flush landing checkpoint; direct ride entry starts course clock0 at spawn.",
    "death_retry": "Normal life debit/full-health retry at ride clock0, never replay flush; preserve selected hero/difficulty.",
    "gap_failure": "Unsupported full-board overlap while grounded is normal1HP contact under shared1.5s immunity; only actual HP depletion causes death. Nonlethal or immune contact recovers in place with0.6s visual bounce, cancels the failed jump and applies0.15s cooldown. No teleport, course skip or clock pause.",
    "finish": "At36 safe course completion; no invented Level3 destination or transition.",
    "obstacle_contact_latch": "First harmful contact latches each obstacle ID until the board fully passes it, even on immune entry; no deferred hit. Bank sidestep alone does not clear the latch. Reset/retry clears all latches; other obstacles remain active under shared immunity."
  },
  "witness_policy": "Neutral horizontal input; steer toward356 for upper supports or304 for lower supports; center each1.2s jump on obstacle crossing at current fixed anchor. Full board footprint remains airborne over gaps.",
  "limitations": [
    "No promise every input is safe: left steering slows relative gap clearance.",
    "Sampled geometric proof is not human playtest or integrated runtime validation.",
    "Engineering owns packaged tests/roadmap; Art owns all rendered assets."
  ],
