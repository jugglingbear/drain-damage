extends SceneTree

func _initialize() -> void:
	call_deferred("run_checks")

func run_checks() -> void:
	var host := Node.new()
	root.add_child(host)
	var sound = load("res://scripts/clogfather_audio.gd").new()
	sound.attach(host)
	assert(host.get_child_count() == 4)
	sound.handle_events(["damage_accepted", "damage_accepted", "projectile_hit", "projectile_hit"])
	assert(sound.starts.damage_accepted == 1 and sound.starts.projectile_hit == 1)
	sound.tick(.25)
	sound.handle_events(["damage_accepted", "volley_warning", "idle_optional"])
	assert(sound.starts.damage_accepted == 2 and not sound.starts.has("idle_optional"))
	for index in range(20): sound.handle_events(["projectile_hit"])
	assert(sound.voices[0].playing and host.get_child_count() == 4)
	sound.set_paused(true)
	sound.tick(1)
	sound.handle_events(["acid_warning"])
	assert(sound.clock == .25 and not sound.starts.has("acid_warning"))
	sound.set_paused(false)
	sound.handle_events(["attack_start", "idle_optional", "major_stagger"])
	assert(not sound.voices[0].playing and sound.starts.idle_optional == 1)
	assert(not sound.starts.has("major_stagger"))
	sound.handle_events(["acid_warning", "acid_impact", "acid_impact"])
	assert(not sound.voices[0].playing)
	sound.tick(.08)
	sound.handle_events(["acid_warning", "acid_impact"])
	assert(sound.starts.acid_impact == 1 and not sound.voices[0].playing)
	sound.handle_events(["volley_warning", "projectile_spawn", "weak_point_closing", "phase_changed"])
	assert(not sound.voices[0].playing and host.get_child_count() == 4)
	for warning_event in ["gas_warning", "reinforcements_warning"]:
		sound.handle_events([warning_event, "projectile_hit", "idle_optional"])
		assert(sound.voices[0].stream == sound.streams[warning_event][0])
		assert(sound.voices[0].playing and sound.voices[0].volume_db == -5)
		assert(sound.starts.idle_optional == 1 and host.get_child_count() == 4)
		var frozen_clock: float = sound.clock
		sound.set_paused(true)
		sound.tick(1.2)
		sound.handle_events(["gas_started", "reinforcements_spawn"])
		assert(sound.clock == frozen_clock and sound.voices[0].stream_paused)
		assert(not sound.starts.has("gas_started"))
		sound.set_paused(false)
		sound.handle_events(["reinforcements_spawn"])
		assert(not sound.voices[0].playing and not sound.starts.has("reinforcements_spawn"))
	sound.handle_events(["gas_warning", "gas_started"])
	assert(not sound.voices[0].playing and sound.starts.gas_started == 1)
	assert(sound.voices[3].stream == sound.streams.gas_started[0])
	sound.handle_events(["acid_warning", "gas_destroyed", "gas_damaged"])
	assert(sound.starts.gas_destroyed == 1 and not sound.starts.has("gas_damaged"))
	assert(sound.voices[0].playing, "Gas hit cannot steal warning voice")
	sound.tick(.12)
	sound.handle_events(["gas_damaged"])
	assert(sound.starts.gas_damaged == 1)
	AudioServer.set_bus_mute(0,true)
	var warning_starts: int = sound.starts.gas_warning
	sound.handle_events(["gas_warning", "gas_started", "reinforcements_warning"])
	assert(sound.starts.gas_warning == warning_starts and sound.starts.gas_started == 1)
	AudioServer.set_bus_mute(0,false)
	sound.handle_events(["gas_warning", "gas_started", "damage_accepted", "death_started", "death_started"])
	assert(sound.defeated and sound.starts.death_started == 1 and sound.starts.damage_accepted == 2)
	assert(sound.starts.gas_started == 1, "Terminal batch suppresses hazard release")
	for index in [0,2,3]: assert(not sound.voices[index].playing)
	sound.handle_events(["death_started"])
	assert(sound.starts.death_started == 1)
	sound.stop()
	AudioServer.set_bus_mute(0,true)
	sound.handle_events(["death_started"])
	AudioServer.set_bus_mute(0,false)
	sound.handle_events(["death_started"])
	assert(sound.starts.death_started == 1, "Muted defeat must not replay on unmute")
	sound.stop()
	sound.tick(20)
	assert(not sound.starts.has("ambient_roar"), "No ambient roar outside encounter")
	sound.set_presence(true)
	sound.tick(10)
	assert(sound.starts.ambient_roar == 1 and host.get_child_count() == 4)
	sound.set_presence(true, true)
	assert(not sound.voices[3].playing, "Full warning state preempts roar")
	sound.handle_events(["phase_changed"])
	assert(not sound.starts.has("reactive_roar"))
	sound.tick(14)
	assert(sound.starts.ambient_roar == 1, "Whole tell protected after warning sample ends")
	sound.set_presence(true, false)
	sound.handle_events(["phase_changed"])
	assert(sound.starts.reactive_roar == 1)
	sound.voices[3].stop()
	sound.handle_events(["phase_changed"])
	assert(sound.starts.reactive_roar == 1, "Shared roar cooldown")
	sound.set_paused(true)
	var paused_clock: float = sound.clock
	sound.tick(30)
	assert(sound.clock == paused_clock and sound.starts.ambient_roar == 1)
	sound.set_paused(false)
	AudioServer.set_bus_mute(0, true)
	sound.tick(30)
	AudioServer.set_bus_mute(0, false)
	sound.tick(.01)
	assert(sound.starts.ambient_roar == 1, "No muted roar backlog")
	sound.handle_events(["death_started"])
	sound.tick(30)
	assert(not sound.presence_active and sound.starts.ambient_roar == 1)
	sound.dispose()
	host.queue_free()
	await create_timer(.2).timeout
	print("PASS: Clogfather bounded events, canonical damage, cooldowns, priority, pause/mute/death/reset")
	quit()
