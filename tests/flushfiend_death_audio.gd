extends SceneTree

func _initialize() -> void:
	call_deferred("run_checks")

func run_checks() -> void:
	var game = load("res://scripts/game.gd").new()
	root.add_child(game)
	game.set_process(false)
	game.set_physics_process(false)
	game.dialogue.finish()
	game.enemies.append(game.Data.spawn("toilet",Vector2(300,404)))
	game.enemies.append(game.Data.spawn("toilet",Vector2(500,404)))
	var cue = game.flushfiend_death_audio
	assert(cue.voices.size() == 4)
	assert(is_equal_approx(cue.voices[0].stream.get_length(),0.75))
	assert(cue.voices[0].volume_db == -3)
	assert(cue.voices[0].stream.loop_mode == AudioStreamWAV.LOOP_DISABLED)
	game.damage_enemy(0,1,Vector2.ZERO)
	assert(cue.starts == 0 and cue.hit_starts == 1)
	game.damage_enemy(0,10000,Vector2.ZERO)
	assert(cue.starts == 1)
	game.damage_enemy(0,10000,Vector2.ZERO,false)
	assert(cue.starts == 2 and game.player_kills == 1)
	for index in range(12): cue.play_defeat()
	assert(cue.voices.size() == 4 and cue.starts == 14)
	game.set_paused(true)
	for voice in cue.voices: assert(voice.stream_paused)
	cue.play_defeat()
	assert(cue.starts == 14)
	game.set_paused(false)
	AudioServer.set_bus_mute(0,true)
	cue.play_defeat()
	assert(cue.starts == 14)
	AudioServer.set_bus_mute(0,false)
	game.reset_game()
	for voice in cue.voices: assert(not voice.playing and not voice.stream_paused)
	cue.play_defeat()
	game.request_title()
	for voice in cue.voices: assert(not voice.playing)
	game.queue_free()
	await process_frame
	assert(cue.voices.is_empty())
	var integrated = load("res://scripts/integrated_first_call.gd").new()
	root.add_child(integrated)
	integrated.set_process(false)
	integrated.set_physics_process(false)
	integrated.actors.clear()
	integrated.enemies.clear()
	integrated.swarms.actors.clear()
	integrated.actors.append({"event_id":"fixture","role":"runner","feet":Vector2(1400,440),
		"hp":24.0,"max_hp":24.0,"active":true,"flash":0.0,"facing":-1.0,
		"runner":integrated.Data.spawn("toilet",Vector2(1381,404))})
	integrated.shots.append({"pos":Vector2(1350,410),"dir":Vector2.RIGHT,"damage":24.0,
		"speed":760.0,"range":320.0,"distance":0.0})
	integrated.step_trial_shots(0.1)
	assert(integrated.actors[0].hp == 0 and integrated.flushfiend_death_audio.starts == 1)
	integrated.step_trial_shots(0.1)
	assert(integrated.flushfiend_death_audio.starts == 1)
	integrated.actors.clear()
	integrated.queue_free()
	await process_frame
	print("PASS: lethal-only and environmental shatter, four-voice cap, pause, mute, reset and exit")
	quit()
