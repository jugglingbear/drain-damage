extends SceneTree
const SpecialAudio = preload("res://scripts/starter_special_audio.gd")

func _initialize() -> void: call_deferred("checks")

func checks() -> void:
	var host := Node.new()
	root.add_child(host)
	var audio := SpecialAudio.new()
	audio.attach(host)
	assert(audio.voices.size() == 2 and host.get_child_count() == 3)
	for id: String in audio.streams:
		var stream: AudioStreamWAV = audio.streams[id]
		assert(stream.get_length() > 0)
		assert((stream.loop_mode == AudioStreamWAV.LOOP_FORWARD) == bool(audio.definition.cues[id].loop))
		audio.begin("invalid")
		assert(not audio.active)
	audio.begin("tony")
	assert(audio.event_starts["tony-start"] == 1)
	audio.advance(.5)
	assert(audio.loop_voice.playing and audio.loop_starts == 1)
	var time := audio.elapsed
	audio.begin("tony")
	audio.begin("sean")
	assert(audio.hero == "tony" and audio.elapsed == time and audio.loop_starts == 1)
	audio.advance(3,true)
	assert(audio.elapsed == time and audio.loop_voice.stream_paused)
	audio.advance(.1,false)
	assert(not audio.loop_voice.stream_paused and audio.loop_starts == 1)
	AudioServer.set_bus_mute(0,true)
	audio.advance(.2)
	assert(audio.loop_starts == 1)
	AudioServer.set_bus_mute(0,false)
	audio.advance(.2)
	assert(audio.loop_starts == 1,"Unmute must not restart the loop")
	audio.advance(5.85)
	assert(not audio.loop_voice.playing and audio.event_starts["tony-stop"] == 1)
	audio.advance(.65)
	assert(not audio.active)
	for voice in audio.voices: assert(not voice.playing)
	audio.begin("sean")
	audio.advance(.31)
	assert(audio.event_starts["sean-pull"] == 1)
	audio.advance(.55)
	assert(audio.event_starts["sean-break"] == 1)
	audio.advance(.15)
	assert(audio.event_starts["sean-erupt"] == 1)
	audio.advance(.2)
	assert(audio.loop_voice.playing and audio.loop_starts == 2)
	audio.advance(2.05)
	assert(audio.event_starts["sean-hinge"] == 1 and audio.loop_starts == 2)
	audio.advance(2.75)
	assert(audio.event_starts["sean-stop"] == 1)
	audio.advance(.1)
	assert(not audio.loop_voice.playing)
	audio.stop()
	assert(not audio.active and not audio.paused and audio.elapsed == 0)
	for voice in audio.voices: assert(not voice.playing)
	audio.empty()
	assert(audio.event_starts["hud-empty"] == 1)
	audio.set_paused(true)
	audio.empty()
	assert(audio.event_starts["hud-empty"] == 1)
	audio.stop()
	var prior_pull := int(audio.event_starts["sean-pull"])
	audio.begin("sean")
	audio.advance(5)
	assert(audio.event_starts["sean-pull"] == prior_pull,"Expired cues must not burst after a stall")
	assert(audio.loop_voice.playing)
	audio.stop()
	audio.begin("tony")
	audio.advance(8)
	assert(not audio.active and not audio.loop_voice.playing)
	audio.attach(host)
	await process_frame
	assert(host.get_child_count() == 3,"Repeated attach must free prior voices")
	audio.dispose()
	audio.dispose()
	await process_frame
	assert(host.get_child_count() == 0)
	host.queue_free()
	await process_frame
	# Let the audio mixer release stopped playback references before terminating the test process.
	await create_timer(.2).timeout
	print("Starter special audio: timing, loop bounds, pause, mute, cancel, stall, retry and disposal PASS")
	quit()
