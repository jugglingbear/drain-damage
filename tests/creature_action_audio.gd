extends SceneTree

func _initialize() -> void: call_deferred("run_checks")

func run_checks() -> void:
	var host := Node.new()
	root.add_child(host)
	var Action = load("res://scripts/creature_action_audio.gd")
	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/creature-action-audio.json"))
	var count := 0
	for creature in data.creatures:
		var bank = Action.new()
		bank.attach(host,creature)
		assert(bank.voices.size() == 4)
		for event in data.creatures[creature]:
			var spec: Dictionary = data.creatures[creature][event]
			assert(absf(bank.streams[event].get_length()-float(spec.duration_seconds)) < .001)
			assert(bank.streams[event].loop_mode == AudioStreamWAV.LOOP_DISABLED)
			count += 1
		bank.dispose()
	assert(count == 48)
	var a = Action.new()
	var b = Action.new()
	a.attach(host,"spider")
	b.attach(host,"toilet")
	a.play("warning",1,0)
	a.play("warning",2,0)
	a.stop_actor(1)
	assert(not a.voices[0].playing and a.voices[1].playing,"Cancellation isolates actors")
	a.play("warning",1,0)
	assert(a.starts.warning == 3,"Retry can warn immediately")
	a.play("attack",1,0)
	assert(not a.voices[0].playing and a.voices[1].playing,"Action stops only its own tell")
	a.play("scuttle",1,.1)
	assert(not a.starts.has("scuttle"),"Movement cannot cut an action transient")
	a.stop()
	a.play("scuttle",1,1)
	a.play("scuttle",2,1)
	b.play("step",3,1)
	assert(not b.starts.has("step") and a.movement_count() == 2,"Global movement cap")
	a.stop_actor(1)
	b.play("step",3,1)
	assert(b.starts.step == 1)
	b.play("step",3,1.1)
	assert(b.starts.step == 1,"Per actor motion throttle")
	a.stop()
	b.stop()
	a.play("warning",1,2)
	a.set_paused(true)
	assert(a.voices[0].stream_paused)
	a.play("attack",1,2)
	assert(a.starts.attack == 1,"Pause consumes no new audio calls")
	a.set_paused(false)
	assert(not a.voices[0].stream_paused)
	AudioServer.set_bus_mute(0,true)
	a.play("attack",1,3)
	assert(a.starts.attack == 1)
	AudioServer.set_bus_mute(0,false)
	a.stop()
	assert(a.cooldowns.is_empty() and not a.paused)
	for voice in a.voices: assert(not voice.playing)
	a.play("warning",1,0)
	assert(a.voices[0].playing)
	a.dispose()
	b.dispose()
	var controller = load("res://scripts/creature_audio.gd").new("spider")
	controller.attach(host)
	var actor := {"hp":10,"age":0.0}
	controller.play_action("warning",actor)
	assert(actor.has("audio_token") and controller.actions.starts.warning == 1)
	controller.set_paused(true)
	assert(controller.actions.paused)
	controller.set_paused(false)
	controller.stop_actor_actions(actor)
	for voice in controller.actions.voices: assert(not voice.playing)
	controller.dispose()
	host.queue_free()
	await create_timer(.3).timeout
	print("PASS: 48 finite cues, bounded voices, actor isolation/retry, action priority, movement cap, pause/mute/reset")
	quit()
