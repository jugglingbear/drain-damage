extends SceneTree

func _initialize() -> void:
	call_deferred("run_checks")

func run_checks() -> void:
	var host := Node.new()
	root.add_child(host)
	var sound = load("res://scripts/skitterling_audio.gd").new()
	sound.attach(host)
	assert(sound.beds.size() == 2 and sound.effects.size() == 2)
	sound.event("swarm_entry")
	sound.step(.15)
	assert(sound.target == 1 and sound.levels[1] == 1)
	sound.set_paused(true)
	var before: float = sound.clock
	sound.step(1)
	sound.event("rat_assembly")
	assert(sound.clock == before and sound.target == 1)
	sound.set_paused(false)
	sound.event("rat_assembly")
	sound.step(.15)
	assert(sound.target == 0 and sound.levels == [1.0,0.0])
	sound.event("rat_phase_defeat")
	sound.step(.15)
	assert(sound.target == -1 and sound.damage.death_starts == 0)
	sound.event("reskitter")
	for key in sound.CUES:
		sound.event(key)
	sound.event("debris_impact")
	assert(sound.event_starts.debris_impact == 1)
	var releases: int = sound.event_starts.debris_release
	var warnings: int = sound.event_starts.tail_warning
	var impacts: int = sound.event_starts.debris_impact
	var burst_nodes: int = host.get_child_count()
	sound.event("swim_start")
	sound.step(.15)
	sound.event("tail_warning")
	sound.step(.8)
	for throw_index in range(6):
		if throw_index > 0: sound.step(.22)
		if throw_index == 3:
			var frozen_clock: float = sound.clock
			sound.set_paused(true)
			sound.step(2)
			sound.event("debris_release")
			sound.event("debris_impact")
			assert(sound.clock == frozen_clock and sound.event_starts.debris_release == releases+3)
			assert(sound.event_starts.debris_impact == impacts+3)
			sound.set_paused(false)
		assert(sound.target == 1 and sound.levels[1] == 1)
		sound.event("debris_release")
		assert(not sound.warning.playing, "Throw cancels the longer warning tail")
		sound.event("debris_impact")
		assert(sound.effects.size() == 2 and host.get_child_count() == burst_nodes)
	assert(sound.event_starts.debris_release == releases+6)
	assert(sound.event_starts.debris_impact == impacts+6)
	assert(sound.event_starts.tail_warning == warnings+1)
	sound.stop()
	assert(sound.target == -1 and sound.clock == 0 and sound.impact_after == 0)
	for voice in sound.effects+sound.beds:
		assert(not voice.playing and not voice.stream_paused)
	sound.event("debris_impact")
	assert(sound.event_starts.debris_impact == impacts+7, "Reset clears the impact throttle")
	sound.event("alligator_assembly")
	sound.step(1.34)
	assert(not sound.cue_cutoffs.is_empty())
	sound.set_paused(true)
	sound.step(1)
	assert(not sound.cue_cutoffs.is_empty(), "Pause freezes assembly cutoff")
	sound.set_paused(false)
	sound.step(.061)
	assert(sound.cue_cutoffs.is_empty(), "Assembly tail stops at the shortened transition")
	sound.event("water_emerge")
	sound.step(.15)
	assert(sound.target == 0)
	var snaps: int = sound.event_starts.jaw_snap
	for leg in range(2):
		sound.event("alligator_jaw_warning")
		sound.event("attack_start")
		sound.event("jaw_snap")
		assert(not sound.warning.playing)
	assert(sound.event_starts.jaw_snap == snaps+2 and sound.effects.size() == 2)
	sound.set_paused(true)
	sound.event("jaw_snap")
	assert(sound.event_starts.jaw_snap == snaps+2)
	sound.set_paused(false)
	var node_count: int = host.get_child_count()
	for pair in [["rat_pounce_warning", "rat_pounce"], ["rat_rush_warning", "rat_rush"],
		["alligator_tail_warning", "alligator_tail_sweep"]]:
		var starts: int = int(sound.event_starts.get(pair[0], 0))
		sound.event("rat_climb")
		sound.event(pair[0])
		assert(sound.event_starts[pair[0]] == starts+1)
		assert(sound.warning.stream == sound.streams[pair[0]])
		sound.set_paused(true)
		sound.event(pair[0])
		assert(sound.event_starts[pair[0]] == starts+1)
		sound.set_paused(false)
		sound.event("attack_start")
		sound.event(pair[1])
		assert(not sound.warning.playing)
		sound.event("rat_pounce_land")
		assert(host.get_child_count() == node_count and sound.target == 0)
	AudioServer.set_bus_mute(0,true)
	var pounce_starts: int = sound.event_starts.rat_pounce_warning
	sound.event("rat_pounce_warning")
	assert(sound.event_starts.rat_pounce_warning == pounce_starts)
	sound.event("terminal_death")
	assert(sound.defeated and sound.damage.death_starts == 0)
	AudioServer.set_bus_mute(0,false)
	sound.event("terminal_death")
	assert(sound.damage.death_starts == 0, "Muted defeat cannot replay after unmute")
	sound.stop()
	var actor := {"hp":10.0}
	sound.play_hit(actor)
	sound.play_hit(actor)
	assert(sound.damage.hit_starts == 1)
	sound.event("terminal_death")
	sound.event("terminal_death")
	assert(sound.damage.death_starts == 1 and sound.target == -1)
	sound.dispose()
	host.queue_free()
	await create_timer(.2).timeout
	print("PASS: Skitterling audio bounded pools, phase/death separation, pause/mute/reset checks pass")
	quit()
