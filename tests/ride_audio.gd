extends SceneTree
const Audio = preload("res://scripts/level_two_ride_audio.gd")

func _initialize() -> void:
	call_deferred("checks")

func checks() -> void:
	var host := Node.new()
	root.add_child(host)
	var audio := Audio.new()
	var data: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/level-two-ride.json"))
	audio.attach(host,data.audio.cues)
	assert(audio.voices.size() == 3)
	audio.advance(0.1,false,true)
	assert(audio.voices.current.playing and audio.starts.current_loop == 1)
	assert(audio.voices.current.pitch_scale == 1)
	audio.play("ride_land")
	assert(not audio.voices.mechanism.playing)
	audio.play("hinge_move")
	assert(audio.starts.hinge_move == 1)
	audio.play("ride_land")
	assert(audio.starts.ride_land == 1)
	audio.play("hinge_move")
	audio.play("hinge_move")
	assert(audio.starts.hinge_move == 1 and audio.voices.mechanism.playing)
	assert(audio.voices.contact.stream == audio.cues.ride_land.stream)
	audio.advance(1,true,true)
	assert(audio.voices.current.stream_paused and audio.cooldown == 0.12)
	assert(audio.voices.mechanism.stream_paused)
	audio.play("ride_impact")
	assert(not audio.starts.has("ride_impact"))
	AudioServer.set_bus_mute(0,true)
	audio.advance(0,true,true)
	assert(not audio.voices.current.playing and not audio.voices.contact.playing)
	assert(not audio.voices.mechanism.playing)
	audio.play("hinge_move")
	assert(audio.starts.hinge_move == 1)
	audio.play("ride_land")
	assert(audio.starts.ride_land == 1)
	AudioServer.set_bus_mute(0,false)
	audio.advance(0.2,false,true)
	assert(audio.starts.current_loop == 2)
	audio.play("ride_impact")
	assert(audio.starts.ride_impact == 1 and audio.voices.contact.volume_db == -8)
	for event in ["metal_impact","porcelain_contact","soft_contact","water_launch"]:
		audio.advance(0.2,false,true)
		audio.play(event)
		assert(audio.starts[event] == 1)
		assert(audio.voices.contact.stream == audio.cues[event].stream)
		assert(audio.voices.contact.volume_db == -6)
		assert(audio.voices.contact.stream.loop_mode == AudioStreamWAV.LOOP_DISABLED)
	audio.play("hinge_move")
	assert(audio.starts.hinge_move == 2 and audio.voices.mechanism.volume_db == -8)
	audio.stop_mechanism()
	assert(not audio.voices.mechanism.playing and audio.voices.current.playing)
	audio.play("hinge_move")
	assert(audio.starts.hinge_move == 3)
	audio.advance(0,false,false)
	assert(not audio.voices.mechanism.playing)
	assert(not audio.voices.current.playing and not audio.voices.contact.playing)
	audio.stop()
	assert(audio.cooldown == 0 and not audio.frozen)
	audio.dispose()
	assert(audio.cues.is_empty() and audio.voices.current.stream == null)
	assert(audio.voices.mechanism.stream == null)
	audio = null
	host.queue_free()
	await process_frame
	print("PASS: three bounded ride voices, material routing, independent mechanism, pause/mute/drop/reset/disposal")
	quit()
