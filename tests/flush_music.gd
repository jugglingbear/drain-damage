extends SceneTree
const Music = preload("res://scripts/flush_music.gd")

func _initialize() -> void:
	call_deferred("checks")

func checks() -> void:
	var host := Node.new()
	root.add_child(host)
	var music := Music.new()
	var content: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/level-two-flush.json"))
	music.attach(host,content.music)
	assert(absf(music.voice.stream.get_length()-45.0) < 0.01 and not music.voice.stream.loop)
	music.advance(0,0,false,true,false,false)
	assert(music.voice.playing and music.starts == 1 and music.seek_time == 0)
	music.advance(12,0.2,false,true,true,true)
	assert(music.seek_time == 12 and music.starts == 1)
	assert(music.voice.volume_db == -16,"Strongest duck wins; radio and burble do not stack")
	music.advance(12,2,true,true,false,false)
	assert(music.voice.stream_paused and music.seek_time == 12 and music.duck == -8)
	music.advance(12,0.2,false,true,false,false)
	assert(not music.voice.stream_paused and music.voice.volume_db == -8)
	AudioServer.set_bus_mute(0,true)
	music.advance(20,0.1,false,true,false,false)
	assert(not music.voice.playing)
	AudioServer.set_bus_mute(0,false)
	music.advance(23,0.1,false,true,false,false)
	assert(music.voice.playing and music.seek_time == 23 and music.starts == 2)
	music.advance(45,0.1,false,true,false,false)
	assert(not music.voice.playing)
	music.stop()
	music.advance(0,0.1,true,true,false,false)
	assert(not music.voice.playing,"Held entry guard must not start the countdown")
	music.advance(0,0.1,false,true,false,false)
	assert(music.voice.playing and music.seek_time == 0)
	music.advance(3,0.1,false,false,false,false)
	assert(not music.voice.playing,"Death or inactive scene stops the music")
	music.dispose()
	assert(music.voice.stream == null)
	host.queue_free()
	await process_frame
	print("PASS: 45s non-looping score, clock seek, pause/mute/retry, strongest duck and cleanup")
	quit()
