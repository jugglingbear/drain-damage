extends SceneTree

func _initialize() -> void: call_deferred("run_checks")

func run_checks() -> void:
	var host := Node.new()
	root.add_child(host)
	var cinematic = load("res://scripts/starter_cinematic_audio.gd").new()
	var water = load("res://scripts/starter_special_audio.gd").new()
	cinematic.attach(host)
	water.attach(host)
	assert(host.get_child_count() == 5)
	cinematic.begin("tony")
	cinematic.advance(.54)
	assert(cinematic.event_starts.is_empty())
	cinematic.advance(.02)
	assert(cinematic.event_starts["tony-crank"] == 1)
	cinematic.begin("tony")
	assert(cinematic.elapsed > .55)
	cinematic.set_paused(true)
	cinematic.advance(2)
	assert(cinematic.elapsed < .57 and cinematic.voices[0].stream_paused)
	cinematic.seek(1.8)
	assert(cinematic.event_starts["tony-pressure"] == 1 and cinematic.paused)
	assert(cinematic.event_starts["tony-crank"] == 1,"Seek skips expired crank")
	cinematic.set_paused(false)
	cinematic.advance(1.4)
	assert(not cinematic.active)
	for voice in cinematic.voices: assert(not voice.playing)
	water.begin_from_cinematic("tony")
	assert(water.elapsed == 0 and water.loop_active and water.loop_starts == 1)
	assert(water.event_starts["tony-start"] == 1)
	water.begin_from_cinematic("tony")
	assert(water.loop_starts == 1)
	water.advance(.1)
	assert(is_equal_approx(water.loop_voice.volume_db,-8))
	water.advance(6.71)
	assert(not water.loop_active and water.event_starts["tony-stop"] == 1)
	water.stop()
	cinematic.stop()
	cinematic.begin("sean")
	cinematic.seek(2.5)
	assert(cinematic.event_starts["sean-break"] == 1)
	assert(not cinematic.event_starts.has("sean-pull"),"No backlog at seek")
	cinematic.stop()
	cinematic.begin("sean")
	cinematic.advance(1)
	cinematic.advance(.08)
	cinematic.advance(.70)
	assert(cinematic.event_starts["sean-pull"] == 2)
	cinematic.stop()
	AudioServer.set_bus_mute(0,true)
	cinematic.begin("tony")
	cinematic.advance(.6)
	AudioServer.set_bus_mute(0,false)
	cinematic.advance(.01)
	assert(cinematic.event_starts["tony-crank"] == 1,"Muted event does not replay")
	cinematic.stop()
	water.begin_from_cinematic("sean")
	assert(water.elapsed == 1 and water.loop_active and water.loop_starts == 2)
	assert(water.event_starts["sean-erupt"] == 1)
	for cue in ["sean-seal","sean-pull","sean-break"]: assert(not water.event_starts.has(cue))
	water.advance(.49)
	assert(not water.event_starts.has("sean-hinge"))
	water.advance(.02)
	assert(water.event_starts["sean-hinge"] == 1)
	water.advance(4.5)
	assert(water.event_starts["sean-stop"] == 1 and water.loop_active)
	water.advance(.1)
	assert(not water.loop_active)
	var tail := false
	for voice in water.voices:
		if voice.stream == water.streams["sean-stop"]: tail = voice.playing
	assert(tail,"Stopping core must preserve 1.5s shutdown tail")
	assert(is_equal_approx(water.streams["sean-stop"].get_length(),1.5))
	water.advance(1.4)
	assert(not water.active)
	water.dispose()
	cinematic.dispose()
	host.queue_free()
	await create_timer(.3).timeout
	print("PASS cinematic pause/seek/cancel/mute and water-only entries, once-only onset, hinge and complete tail")
	quit()
