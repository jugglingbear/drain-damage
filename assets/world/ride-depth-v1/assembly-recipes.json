  "schema_version": 1,
  "status": "Revised for Prototype129 POC-matched presentation; overall visual acceptance pending",
  "owner": "Bestiary / Art",
  "integration_owner": "Engineering",
  "contract": {
    "units": "meters; 100 legacy pixels = 1 meter",
    "axes": "X travel, Y up, Z bank; obstacle-local origin at water-level footprint center",
    "parameters": "W=obstacle.width/100; D=2*obstacle.depth/100 in presentation; B=-0.8; C=2.4; S=nearest wall sign",
    "expressions": "Symbolic engineering recipes, not executable expressions or a runtime parser contract",
    "components": "Sizes and centers are XYZ meters; cylinder axes default Y; endpoints override cylinder orientation",
    "collision": "Visual-only assembly. Existing model owns every footprint, damage threshold and event time",
    "deck_support": "Cleanout uses true elliptical lid support+.12 with no rectangular corner support or waterpatch. Mechanics owns footprint/landing/pit parity; basins keep rectangular support.",
    "texture_density": "256 pixels/meter; world UVs; extract atlas cells before repeat to prevent adjacent-cell bleed",
    "lighting": "Opaque solids, depth-tested; subdued roughness highlights; no emissive metal or baked cast shadows",
    "support": "Support reaches actual floor: ordinary water bedY-.8, lethal shaftfloorY-2 for ride deck piers. Overhead equipment attached to supported beams. No hidden gap between pier and floor.",
    "camera": "Initial yaw -18/+18 degrees, pitch 35 degrees; inspect occlusion at both views",
    "overhead_support": "Crossbeam Y2.4 spanning banks; sideposts outside playable |Z|<=1 extend to bedY-.8. All mount plates attach to beam. Near post must not hide rider or cue.",
    "bank_presentation": "Map model bankZ=(y-330)/100 to renderedZ=2*bankZ; multiply all bank depths, positions, masks and support visuals consistently. Simulation unchanged.",
    "composition": "Water Z\u00b12; POC far wall top1.1 and near coping top.12; narrow dark outerbanks, camera size5.2 baseline. Avoid dominant bright walkways.",
    "environment_motion": "World textures scroll with continuous model travel at scrollspeed; water has additional relative flow. Pause freezes both.",
    "support_material": "neutral_support_iron: support-only luminance/desaturation of existing cast_iron texture, warmgray midtones and retained microdetail. Proposed runtime material, not new raster asset."
  },
