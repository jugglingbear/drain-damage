  },
  "water": {
    "bottom_y": 520,
    "height_rule": "56 * interpolated water_depth_fraction; scale destination height to this value, retaining ripple surface at its top. Clip inside bore. Omit at depth zero.",
    "motion": "Scroll world-relative phase right at local flow speed; pause with gameplay. Do not reverse with player."
  },
  "buildup": {
    "rule": "Bottom-anchor light/medium/heavy at y520. Select or crossfade by interpolated coverage; scale height to 56*coverage, clip to bore. At x8570 use plug across entire bore with no floaters/water.",
    "terminal_rule": "Use inset plug crop to avoid transparent perimeter; alpha min249/255. Draw plug over opaque interior, no gaps or boss silhouette."
  },
  "debris": {
    "anchor_rule": "Place anchor at water surface, slight submergence. Clip to bore; max8 pieces; stable world segment seed.",
