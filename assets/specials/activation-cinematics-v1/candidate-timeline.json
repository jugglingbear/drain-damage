        "end": 0.55,
        "action": "Hold starting pressure long enough to read the mechanical setup."
      },
      {
        "id": "crank",
        "start": 0.55,
        "end": 1.75,
        "action": "Separate dial turns clockwise through one full turn. Needle follows pressure rise from one-third through red to the physical maximum."
      },
      {
        "id": "overpressure",
        "start": 1.75,
        "end": 2.75,
        "action": "One full second of unit-local tremble; needle pinned at maximum, not a second loading hold. Keep dial attached and readable."
      },
      {
        "id": "release",
        "start": 2.75,
        "end": 3.2,
        "action": "Fade assembly away. Final pressure-release hiss connects to the actual weapon nozzle. Resume with Hydrojet Overdrive at elapsed zero."
