    "feet_world": "Capture player_top_left + (13,46) once on accepted activation",
    "socket_world": "Captured feet + (44 * captured_facing,0)",
    "source_rect_coordinates": "Atlas pixels; pivots are relative to cropped cell, not whole atlas",
    "right_facing_transform": "world = captured_feet + (source_pixel - source_feet_pivot) * scale",
    "left_facing_transform": "Mirror local X around captured feet: world = captured_feet + ((source_x-pivot_x)*scale*facing,(source_y-pivot_y)*scale), facing=-1",
